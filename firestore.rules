rules_version = '2';
// SJA — sirf yahan likhe gaye email login kar ke data dekh / likh sakte hain.
// Gmail milne par neeche list mein daalein, phir: npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null && request.auth.token.email in [
        "sheikhasifmandi786@gmail.com"
      ];
    }
    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
